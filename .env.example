# Public values are safe to expose in the browser. They are inlined during the Next.js build.
NEXT_PUBLIC_SITE_URL=https://sculptedbyruby.uk
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Cloudflare Turnstile. This is Cloudflare's always-pass test site key; production uses the real one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
