# Public values are safe to expose in the browser. They are inlined during the Next.js build.
NEXT_PUBLIC_SITE_URL=https://sculptedbyruby.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Business defaults. Provider secrets will be added to Supabase Edge Functions in a later section.
BUSINESS_TIMEZONE=Europe/London
